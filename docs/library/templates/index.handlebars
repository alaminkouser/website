<!doctype html>
<html lang="en">
  <head>
    {% with title = "{{title}}" %}
      {% with description = "{{excerpt}}" %}
        {% include "templates/head.html" %}
      {% endwith %}
    {% endwith %}
    <link rel="stylesheet" href="/docs/index.css" />
  </head>
  <body>
    {% include "templates/nav.html" %}
    <main>
      <h1>{{title}}</h1>
      <p><strong>
        <time datetime="{{dateISO}}">
          <strong>{{dateFormatted}}</strong>
        </time>
      </strong></p>
      <div>
        {{{body}}}
        <hr />
        <p>
          <small>Keywords:
            {{#each keywords}}
              <a href="/docs/keywords/{{this}}/">{{this}}</a>{{#unless @last}}, {{/unless}}
            {{/each}}
          </small>
        </p>
      </div>
    </main>
    {% include "templates/footer.html" %}
  </body>
</html>